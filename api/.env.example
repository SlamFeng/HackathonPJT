NANOBANANA_API_KEY=
NANOBANANA_ENDPOINT=
# 参考官方文档：Nano Banana 2 对应 gemini-3.1-flash-image-preview
NANOBANANA_MODEL=gemini-3.1-flash-image-preview

# ===== Phase 1：数据库与鉴权 =====
# docker compose 会自动注入下列变量；仅在「不用 Docker 直跑」时才需要在此填写。
# DATABASE_URL=postgresql+asyncpg://ailurus:ailurus@localhost:5432/ailurus
# SESSION_SECRET=change-me-in-prod
# COOKIE_SECURE=false          # 生产 HTTPS 下设为 true
# CORS_ORIGINS=http://localhost:3000   # 逗号分隔多个来源
# 首次启动自动创建的管理员（邮箱需为合法域名，勿用 .local）
# ADMIN_EMAIL=admin@ailurus.com
# ADMIN_PASSWORD=admin12345
