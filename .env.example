# ============================================================================
# 部署期 compose 变量（放在仓库根目录 .env，docker compose 会自动读取）
# 复制为 .env 后按需修改：  cp .env.example .env
# 后端的 AI Key 仍放在 api/.env（见 api/.env.example），不要写在这里。
# ============================================================================

# 前端访问后端的公网地址（构建期内联进前端，改后需重新 build web）
# 本地/单机：http://localhost:8000   生产：https://api.你的域名
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 后端允许的前端来源（CORS），逗号分隔多个
# 本地：http://localhost:3000   生产：https://你的域名
CORS_ORIGINS=http://localhost:3000

# 会话签名密钥 —— 生产务必改成随机长串（如 openssl rand -hex 32）
SESSION_SECRET=change-me-to-a-long-random-string

# 生产经 HTTPS 访问时设为 true（否则浏览器不会下发会话 Cookie）
COOKIE_SECURE=false

# Cookie 的 SameSite 策略：同站部署用 lax；
# 跨站部署（前端在 Vercel、后端在另一域名）必须设为 none（代码会自动强制 Secure）。见 docs/deploy-vercel-web.md
COOKIE_SAMESITE=lax

# 首次启动自动创建的管理员（生产务必修改密码；邮箱用合法域名，勿用 .local）
ADMIN_EMAIL=admin@ailurus.com
ADMIN_PASSWORD=admin12345

# 后台生成 worker 并发数（按 Key 配额/机器算力调整）
WORKER_CONCURRENCY=2
