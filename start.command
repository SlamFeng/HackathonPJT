#!/usr/bin/env bash
# ============================================================
#  AI 智能试衣间 —— 一键本地启动（macOS / Linux）
#  在访达里双击这个文件即可。第一次会自动安装环境与依赖。
#  （如果双击没反应，右键 → 打开方式 → 终端；或在终端里运行 ./start.command）
